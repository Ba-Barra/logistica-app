// 1. CONFIGURACIÓN (Esto es lo que faltaba)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 2. TUS MODELOS (El código que ya teníamos)

// Usuarios del Sistema
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("DISPATCHER")
  createdAt DateTime @default(now())
}

// Choferes
model Driver {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  license   String   @unique
  phone     String?
  status    String   @default("AVAILABLE")
  routes    Route[]
}

// Vehículos
model Vehicle {
  id           Int           @id @default(autoincrement())
  plate        String        @unique
  model        String
  capacity     Float
  status       String        @default("ACTIVE")
  routes       Route[]
  maintenances Maintenance[]
}

// Clientes
model Client {
  id          Int        @id @default(autoincrement())
  companyName String
  address     String
  latitude    Float?
  longitude   Float?
  deliveries  Delivery[]
}

// Rutas
model Route {
  id            Int        @id @default(autoincrement())
  scheduledDate DateTime
  status        String     @default("PLANNING")
  
  driverId      Int
  driver        Driver     @relation(fields: [driverId], references: [id])
  
  vehicleId     Int
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])
  
  deliveries    Delivery[]
}

// Entregas
model Delivery {
  id        Int      @id @default(autoincrement())
  status    String   @default("PENDING")
  stopOrder Int?
  notes     String?

  routeId   Int
  route     Route    @relation(fields: [routeId], references: [id])
  
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
}

// Mantenimientos
model Maintenance {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  reason    String
  
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}